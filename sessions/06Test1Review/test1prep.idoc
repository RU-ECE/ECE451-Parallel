@qc(1) Scalar execution takes 1200 cycles. AVX2 execution takes 300 cycles. What is the speedup?
@q(n:4)

@qc(1) Scalar execution takes 2400 cycles. AVX2 execution takes 800 cycles. What is the speedup?
@q(n:3)

@qc(1) Scalar execution takes 1000 cycles. AVX2 execution takes 250 cycles. What is the percentage reduction in execution time?
@q(n:75)

@qc(1) An AVX2 loop processes four doubles per iteration. For N=1000, how many full vector iterations are required?
@q(n:250)

@qc(1) An AVX2 loop processes four doubles per iteration. For N=1003, how many elements remain after full vector iterations?
@q(n:3)

@qc(2) Write scalar C++ code to compute sum(1.0/i) for i=1 through N. No array accesses.
@code(language=cpp, run)
double sum=0.0;
for (int i=1; i<=N; ++i) sum += 1.0/i;)
@end

@qc(2) Write scalar C++ code to compute sum(1.0/(i*i)) for i=1 through N. Avoid integer overflow.
@code(language=c++)
double sum=0.0;
for (int i=1; i<=N; ++i) { 
    double x=i;
    sum += 1.0/(x*x);
}
@end



@qc(1) Scalar execution takes 4000 cycles. AVX2 execution takes 1250 cycles. Calculate speedup to two decimal places.
@q(f:3.20)

@qc(1) Scalar execution takes 6400 cycles. AVX2 execution is 3.2 times faster. How many cycles does AVX2 take?
@q(n:2000)

@qc(1) How many YMM registers are needed to hold 32 doubles?
@q(n:8)

@qc(1) A scalar loop performs 1000 iterations. An AVX2 loop processes four iterations per vector instruction. How many full vector iterations are needed?
@q(n:250)



@qc(10) What does this program print? Explain whether the output is guaranteed.

@code(language=cpp)
int x = 10;

void worker() {
    x = 20;
}

int main() {
    std::thread t(worker);
    std::cout << x << '\n';
    t.join();
}
@end

@qc(10) What does this program print? Explain why.

@code(language=cpp)
void worker(int x) {
    x++;
}

int main() {
    int n = 10;
    std::thread t(worker, n);
    t.join();
    std::cout << n << '\n'; // 10 because x is a COPY
}
@end

@code(language=cpp)
void worker(int* x) {
    (*x)++;
}

int main() {
    int n = 10;
    std::thread t(worker, &n);
    t.join();
    std::cout << n << '\n'; // 11 because the thread is DONE
}
@end


@qc(10) What does this program print? Explain why.

@code(language=cpp)
void worker(int *x) {
    (*x)++;
}

int main() {
    int n = 10;
    std::thread t(worker, &n);
    std::cout << n << '\n'; // will print 10 or 11 depending AND CRASH
}
@end

@code(language=cpp)
int x = 0;
void worker(int n) {
    for (int i = 0; i < n; i++)
      x++;
}

int main() {
    int n = 1000;
    std::thread t1(worker, n);
    std::thread t2(worker, n);
    t1.join();
    t1.join();
    std::cout << n << '\n';
}
@end


